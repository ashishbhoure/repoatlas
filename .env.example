# ---- Required ---------------------------------------------------------------
# PostgreSQL connection string. `docker compose up -d postgres` provides this one.
DATABASE_URL="postgresql://repoatlas:repoatlas@localhost:5433/repoatlas"
# Public base URL of the app (no trailing slash).
APP_URL="http://localhost:3000"

# ---- Strongly recommended ---------------------------------------------------
# Server-side GitHub token used for all public-data requests. A fine-grained PAT with
# "Public repositories (read-only)" and no other permissions is enough.
# Without it: Search API 10 req/min, REST 60 req/hour, per server IP.
GITHUB_TOKEN=""

# ---- Authentication (needed for saved repos, collections, saved searches) --
# Random 32+ character secret. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""
# GitHub OAuth App credentials (https://github.com/settings/developers).
# Callback URL: {APP_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ---- Optional ---------------------------------------------------------------
# Bearer secret for /api/cron/* endpoints (snapshot collection).
CRON_SECRET=""
# Anthropic API key for natural-language search (AI search is disabled when empty).
ANTHROPIC_API_KEY=""
